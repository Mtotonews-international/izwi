# Copy this file to .env and fill it in. On the live server, set these as environment variables.
PORT=3000
NODE_ENV=development            # set to production on the live site
PUBLIC_URL=http://localhost:3000   # the address guardians are sent in the SMS
DATA_DIR=./data                 # the database and uploaded files live here. Back this folder up
MAX_UPLOAD_MB=100
DEFAULT_COUNTRY_CODE=+254

# Text messages to guardians. "console" prints them in the terminal.
SMS_PROVIDER=console
# SMS_PROVIDER=africastalking
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
